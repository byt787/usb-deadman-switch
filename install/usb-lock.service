[Unit]
Description=usb-lock - locks the screen (or shuts down) on USB removal
After=graphical-session.target

[Service]
Type=simple
# %h resolves to $HOME. Adjust the path if the repo lives elsewhere.
WorkingDirectory=%h/usb-lock
ExecStart=/usr/bin/python3 -m usb_lock.gui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
